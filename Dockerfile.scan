ARG SOURCE_DATE_EPOCH=1710000000

FROM node@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS node-base

FROM node-base AS npm-dependencies
ENV NODE_ENV=production
WORKDIR /opt/npm
COPY docker/refresh/locks/reference/package.json /opt/npm/package.json
COPY docker/refresh/locks/reference/package-lock.json /opt/npm/package-lock.json
COPY docker/refresh/.artifacts/reference/npm-cache.tar /offline/npm-cache.tar
RUN mkdir -p /offline/npm-cache/_cacache \
    && tar -xf /offline/npm-cache.tar -C /offline/npm-cache/_cacache \
    && npm ci --offline --ignore-scripts --omit=dev --cache /offline/npm-cache

FROM python@sha256:c17b9ca6def1a936e55c77f086aaaf5f6a6c5f4d2fb4b7ac8c0113ba94e8b6ab AS python-base

FROM python-base AS python-dependencies
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SOURCE_DATE_EPOCH=1710000000
COPY docker/refresh/locks/reference/requirements.in /offline/requirements.in
COPY docker/refresh/locks/reference/requirements.lock /offline/requirements.lock
COPY docker/refresh/.artifacts/reference/python-wheels.tar /offline/python-wheels.tar
RUN python -m venv /opt/venv \
    && mkdir -p /offline/wheels \
    && tar -xf /offline/python-wheels.tar -C /offline/wheels \
    && /opt/venv/bin/pip install --no-index --require-hashes --no-deps --no-compile \
       --find-links /offline/wheels -r /offline/requirements.lock

FROM python-base AS runtime
ENV HOME=/scan \
    NODE_ENV=production \
    PATH=/opt/venv/bin:/opt/npm/node_modules/.bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    SOURCE_DATE_EPOCH=1710000000
COPY --from=node-base /usr/local/bin/node /usr/local/bin/node
COPY --from=npm-dependencies /opt/npm/node_modules /opt/npm/node_modules
COPY --from=python-dependencies /opt/venv /opt/venv
RUN mkdir -p /fixtures/repo \
    && git init /fixtures/repo \
    && git -C /fixtures/repo config user.email "scan-fixture@example.invalid" \
    && git -C /fixtures/repo config user.name "MCP Trust Scan Fixture" \
    && printf "fixture repo for mcp-trust reference scans\n" > /fixtures/repo/README.md \
    && git -C /fixtures/repo add README.md \
    && GIT_AUTHOR_DATE="@1710000000 +0000" GIT_COMMITTER_DATE="@1710000000 +0000" \
       git -C /fixtures/repo commit -m "Add scan fixture" \
    && rm /fixtures/repo/.git/index
WORKDIR /scan
