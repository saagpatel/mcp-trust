ARG SOURCE_DATE_EPOCH=1710000000

FROM python@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134 AS python-base

FROM python-base AS python-dependencies
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SOURCE_DATE_EPOCH=1710000000
COPY docker/refresh/locks/basic-memory/requirements.in /offline/requirements.in
COPY docker/refresh/locks/basic-memory/requirements.lock /offline/requirements.lock
COPY docker/refresh/.artifacts/basic-memory/python-wheels.tar /offline/python-wheels.tar
RUN python -m venv /opt/venv \
    && mkdir -p /offline/wheels \
    && tar -xf /offline/python-wheels.tar -C /offline/wheels \
    && /opt/venv/bin/pip install --no-index --require-hashes --no-deps --no-compile \
       --find-links /offline/wheels -r /offline/requirements.lock

FROM python-base AS runtime
ENV BASIC_MEMORY_AUTO_UPDATE=false \
    BASIC_MEMORY_CONFIG_DIR=/scan/config \
    BASIC_MEMORY_EXPLICIT_ROUTING=true \
    BASIC_MEMORY_FORCE_LOCAL=true \
    BASIC_MEMORY_HOME=/scan/memory \
    BASIC_MEMORY_LOGFIRE_ENABLED=false \
    BASIC_MEMORY_LOGFIRE_SEND_TO_LOGFIRE=false \
    HOME=/scan \
    PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    SOURCE_DATE_EPOCH=1710000000
COPY --from=python-dependencies /opt/venv /opt/venv
WORKDIR /scan
