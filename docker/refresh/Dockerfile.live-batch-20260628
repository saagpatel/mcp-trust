# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:0.8.15 AS uv
FROM node:22-slim

ENV UV_TOOL_DIR=/opt/uv-tools
ENV UV_TOOL_BIN_DIR=/usr/local/bin

COPY --from=uv /uv /uvx /usr/local/bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global \
    "@adeu/mcp-server@1.7.1" \
    "raven-mcp@1.3.3" \
    "@kage-core/kage-graph-mcp@2.3.0" \
    "mythsensus-mcp@0.2.1" \
    "@pulsemcp/image-diff-mcp-server@0.1.3" \
    "@swins/intent-engineering-mcp@0.2.0" \
    "sovereign-ai-act-mcp@1.2.0"

RUN uv tool install --python python3 "kogcat-mcp==0.46.2"

WORKDIR /scan
