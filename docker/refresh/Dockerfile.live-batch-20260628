ARG SOURCE_DATE_EPOCH=1710000000

FROM node@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS node-base

FROM node-base AS npm-dependencies
ENV NODE_ENV=production
WORKDIR /opt/npm
COPY docker/refresh/locks/live-batch/package.json /opt/npm/package.json
COPY docker/refresh/locks/live-batch/package-lock.json /opt/npm/package-lock.json
COPY docker/refresh/.artifacts/live-batch/npm-cache.tar /offline/npm-cache.tar
RUN mkdir -p /offline/npm-cache/_cacache \
    && tar -xf /offline/npm-cache.tar -C /offline/npm-cache/_cacache \
    && npm ci --offline --ignore-scripts --omit=dev --cache /offline/npm-cache

FROM python@sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91 AS python-base

FROM python-base AS python-dependencies
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SOURCE_DATE_EPOCH=1710000000
COPY docker/refresh/locks/live-batch/requirements.in /offline/requirements.in
COPY docker/refresh/locks/live-batch/requirements.lock /offline/requirements.lock
COPY docker/refresh/.artifacts/live-batch/python-wheels.tar /offline/python-wheels.tar
RUN python -m venv /opt/venv \
    && mkdir -p /offline/wheels \
    && tar -xf /offline/python-wheels.tar -C /offline/wheels \
    && /opt/venv/bin/pip install --no-index --require-hashes --no-deps --no-compile \
       --find-links /offline/wheels -r /offline/requirements.lock

FROM python-base AS runtime
ENV HOME=/scan \
    NODE_ENV=production \
    PATH=/opt/venv/bin:/opt/npm/node_modules/.bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    SOURCE_DATE_EPOCH=1710000000
COPY --from=node-base /usr/local/bin/node /usr/local/bin/node
COPY --from=npm-dependencies /opt/npm/node_modules /opt/npm/node_modules
COPY --from=python-dependencies /opt/venv /opt/venv
RUN readlink /opt/npm/node_modules/.bin/adeu-mcp-server | grep -Fqx -- "../@adeu/mcp-server/dist/index.js" \
    && readlink /opt/npm/node_modules/.bin/kage-graph-mcp | grep -Fqx -- "../@kage-core/kage-graph-mcp/dist/index.js" \
    && readlink /opt/npm/node_modules/.bin/image-diff-mcp-server | grep -Fqx -- "../@pulsemcp/image-diff-mcp-server/build/index.js" \
    && readlink /opt/npm/node_modules/.bin/intent-engineering-mcp | grep -Fqx -- "../@swins/intent-engineering-mcp/build/index.js" \
    && readlink /opt/npm/node_modules/.bin/mythsensus-mcp | grep -Fqx -- "../mythsensus-mcp/dist/index.js" \
    && readlink /opt/npm/node_modules/.bin/raven-mcp | grep -Fqx -- "../raven-mcp/dist/index.js" \
    && readlink /opt/npm/node_modules/.bin/sovereign-ai-act-mcp | grep -Fqx -- "../sovereign-ai-act-mcp/index.js"
WORKDIR /scan
