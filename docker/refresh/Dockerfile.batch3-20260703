ARG SOURCE_DATE_EPOCH=1710000000

FROM node@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS node-base

FROM node-base AS npm-dependencies
ENV NODE_ENV=production
WORKDIR /opt/npm
COPY docker/refresh/locks/batch3/package.json /opt/npm/package.json
COPY docker/refresh/locks/batch3/package-lock.json /opt/npm/package-lock.json
COPY docker/refresh/.artifacts/batch3/npm-cache.tar /offline/npm-cache.tar
RUN mkdir -p /offline/npm-cache/_cacache \
    && tar -xf /offline/npm-cache.tar -C /offline/npm-cache/_cacache \
    && npm ci --offline --ignore-scripts --omit=dev --cache /offline/npm-cache

FROM python@sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91 AS runtime
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 \
    HOME=/scan \
    NODE_ENV=production \
    PATH=/opt/npm/node_modules/.bin:/usr/local/bin:/usr/bin:/bin \
    SOURCE_DATE_EPOCH=1710000000
COPY --from=node-base /usr/local/bin/node /usr/local/bin/node
COPY --from=npm-dependencies /opt/npm/node_modules /opt/npm/node_modules
RUN readlink /opt/npm/node_modules/.bin/redacta-mcp | grep -Fqx -- "../redacta-mcp/dist/index.js"
WORKDIR /scan
