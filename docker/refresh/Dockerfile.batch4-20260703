ARG SOURCE_DATE_EPOCH=1710000000

FROM node@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 AS node-base

FROM python@sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91 AS python-base

FROM mcr.microsoft.com/playwright@sha256:5361940f845a5077926d54746122f7b68a121cc2aa27df6241087b774203fc44 AS browser-base

FROM node-base AS npm-dependencies
ENV NODE_ENV=production
WORKDIR /opt/npm
COPY docker/refresh/locks/batch4/package.json /opt/npm/package.json
COPY docker/refresh/locks/batch4/package-lock.json /opt/npm/package-lock.json
COPY docker/refresh/.artifacts/batch4/npm-cache.tar /offline/npm-cache.tar
RUN mkdir -p /offline/npm-cache/_cacache \
    && tar -xf /offline/npm-cache.tar -C /offline/npm-cache/_cacache \
    && npm ci --offline --ignore-scripts --omit=dev --cache /offline/npm-cache

FROM browser-base AS runtime
ENV CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS=1 \
    CI=1 \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 \
    HOME=/scan \
    NODE_ENV=production \
    PATH=/opt/npm/node_modules/.bin:/usr/local/bin:/usr/bin:/bin \
    SOURCE_DATE_EPOCH=1710000000
COPY --from=node-base /usr/local/bin/node /usr/local/bin/node
COPY --from=npm-dependencies /opt/npm/node_modules /opt/npm/node_modules
COPY --from=python-base /usr/local/bin/python3.11 /usr/local/bin/python3.11
COPY --from=python-base /usr/local/lib/libpython3.11.so.1.0 /usr/local/lib/libpython3.11.so.1.0
COPY --from=python-base /usr/local/lib/python3.11 /usr/local/lib/python3.11
RUN install -d -m 0755 /opt/venv/bin \
    && ln -s python3.11 /usr/local/bin/python \
    && ln -s python3.11 /usr/local/bin/python3 \
    && ln -s /usr/local/bin/python /opt/venv/bin/python
RUN test -x /ms-playwright/chromium_headless_shell-1234/chrome-linux/headless_shell \
    && /ms-playwright/chromium_headless_shell-1234/chrome-linux/headless_shell --version \
        | grep -Fqx -- "Chromium 151.0.7922.34"
RUN readlink /opt/npm/node_modules/.bin/playwright-mcp | grep -Fqx -- "../@playwright/mcp/cli.js"
RUN readlink /opt/npm/node_modules/.bin/chrome-devtools-mcp | grep -Fqx -- "../chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js"
RUN readlink /opt/npm/node_modules/.bin/ui5-wcr-mcp | grep -Fqx -- "../@ui5/webcomponents-react-mcp/dist/index.js"
RUN readlink /opt/npm/node_modules/.bin/discourse-mcp | grep -Fqx -- "../@discourse/mcp/dist/index.js"
RUN readlink /opt/npm/node_modules/.bin/nve | grep -Fqx -- "../@nvidia-elements/cli/dist/index.js"
WORKDIR /scan
